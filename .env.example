# ── 1Claw ─────────────────────────────────────────────
# Personal key (1ck_…) — used only by setup scripts, not by the running agent.
ONECLAW_API_KEY=
# The agent identity that holds the USDC, orders cards and is billed for LLM tokens.
ONECLAW_AGENT_ID=
ONECLAW_AGENT_API_KEY=          # ocv_…

# ── LLM (billed via 1Claw Shroud LLM Token Billing) ──
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=            # optional: bypass Shroud and call Anthropic directly

# ── ElevenLabs ────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Gfpl8Yo74Is0W6cPUWWT   # Max

# ── Card / checkout ──────────────────────────────────
CARD_PROVIDER=laso              # laso = pay Laso's x402 directly (signed by the 1Claw key); oneclaw = 1Claw card vault
CARD_MAX_USD=50
DAILY_USDC_LIMIT=20             # rolling 24h cap on USDC spent buying cards
SHIP_TO_MATCH=                  # optional, e.g. 123 MAIN ST — saved address to use; empty = Amazon default
CARD_HOLDER_NAME=               # name typed on the card form
CARD_BILLING_ZIP=               # optional; billing address defaults to the Amazon shipping address

# ── Browser (1Claw browser-bridge) ────────────────────
# ONECLAW_BRIDGE_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_HEADLESS=false          # keep visible so the audience can watch
# Encrypted local vault (browser-bridge LocalVaultDriver) holding the Amazon password for re-login.
ONECLAW_BRIDGE_VAULT=           # e.g. /Users/you/.1claw/ask-1claw-vault.json
ONECLAW_BRIDGE_VAULT_PASSPHRASE= # long random string (e.g. openssl rand -base64 32)

# ── Bowmark (optional, public product search only) ────
BOWMARK_API_KEY=
EXPERIMENT_BOWMARK_CHECKOUT=false  # true = expose buy_via_bowmark (hosted agent checkout; slow, card sent as text)
SEARCH_PROVIDER=bowmark         # bowmark (fewer bot checks on your session) | browser (≈1s faster, free)
AGENT_NAME=Max
